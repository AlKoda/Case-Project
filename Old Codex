-/* ---- qualities: the single vocabulary every storylet is gated on ----
-   ev:<id>    an exhibit has been read
-   found:<id> an exhibit exists on the board
-   wit:<id>   a statement has been taken
-   ask:<id>   a question has been put
-   scene:<id> a point in the room has been searched
-   print:<id> a suspect has been printed
-   match:<id> a print exhibit has been matched to someone            */
-function quality(tok){
-  var i = tok.indexOf(":"), k = tok.slice(i+1);
-  switch(tok.slice(0,i)){
-    case "ev":    return !!state.viewedEv[k];
-    case "found": return !!state.found[k];
-    case "wit":   return !!state.viewedWit[k];
-    case "ask":   return !!state.asked[k];
-    case "scene": return !!state.examined[k];
-    case "print": return !!state.prints[k];
-    case "match": return !!state.matched[k];
-    case "any":   return false;
-    default:      return false;
-  }
-}
-function reqMet(r){
-  if(!r) return true;
-  if(typeof r === "string") return quality(r);
-  if(Array.isArray(r)) return r.every(quality);
-  if(r.any) return r.any.some(quality);
-  if(r.all) return r.all.every(quality);
-  /* legacy shape kept so older entries still resolve */
-  if(r.type === "evidence") return !!state.viewedEv[r.id];
-  if(r.type === "witness")  return !!state.viewedWit[r.id];
-  if(r.type === "match")    return !!state.matched[r.id];
-  return true;
-}
