-/* diagonal yellow/black hazard tape, strung corner-to-corner across a doorway --
-   used only by cases severe enough to warrant it (CASE.tape === true) */
-function hazardBand(x1, y1, x2, y2, h, label){
-  var dx = x2-x1, dy = y2-y1;
-  var len = Math.sqrt(dx*dx + dy*dy);
-  var deg = Math.atan2(dy, dx) * 180 / Math.PI;
-  var mx = (x1+x2)/2, my = (y1+y2)/2;
-  return '<g transform="translate('+mx+' '+my+') rotate('+deg.toFixed(2)+')">' +
-    '<rect x="'+(-len/2)+'" y="'+(-h/2)+'" width="'+len+'" height="'+h+
-      '" fill="url(#hazardStripes)" stroke="#1B1405" stroke-width="1.5"/>' +
-    '<text x="'+(-len*0.27)+'" y="'+(h*0.16)+'" font-family="monospace" font-size="'+(h*0.4)+
-      '" font-weight="700" fill="#1B1405" text-anchor="middle" letter-spacing="1.5">'+label+'</text>' +
-    '<text x="'+(len*0.27)+'" y="'+(h*0.16)+'" font-family="monospace" font-size="'+(h*0.4)+
-      '" font-weight="700" fill="#1B1405" text-anchor="middle" letter-spacing="1.5">'+label+'</text>' +
-    '</g>';
-}
